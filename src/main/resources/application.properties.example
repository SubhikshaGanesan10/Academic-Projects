spring.application.name=ecinemax

# Local MySQL connection. This app connects as a dedicated 'ecinemax_app'
# user (created specifically for this app, with access to only its own
# database) rather than as MySQL's root account - a basic least-privilege
# habit worth having even on a local learning project.
#
# This is a template: copy this file to application.properties (which is
# gitignored, since it holds a real password) and fill in your own password.
spring.datasource.url=jdbc:mysql://localhost:3306/ecinemax_db
spring.datasource.username=ecinemax_app
spring.datasource.password=CHANGE_ME

# Flyway (src/main/resources/db/migration/) now owns the schema. Hibernate
# just checks on startup that the tables actually match our @Entity classes
# and refuses to boot if they've drifted apart - it no longer changes
# anything itself.
spring.jpa.hibernate.ddl-auto=validate

# Prints the actual SQL Hibernate generates to the console - useful for
# seeing exactly what JPA is doing under the hood while learning.
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# Seeds one ADMIN account on first startup, using credentials you choose here
# - nothing is hardcoded in source. Pick your own email/password; if you
# leave these blank, no admin account is created.
app.admin.seed-email=admin@example.com
app.admin.seed-password=CHANGE_ME
