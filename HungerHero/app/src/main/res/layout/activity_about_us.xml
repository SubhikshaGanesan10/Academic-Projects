<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true"
    tools:context=".AboutUs">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="About HungerHero"
            android:textColor="#eba937"
            android:fontFamily="@font/indie_flower_font_family"
            android:textStyle="bold"
            android:textSize="36sp"
            android:textAlignment="center"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Food wastage is a pressing global issue that affects communities, economies, and the environment. HungerHero connects surplus food from donors, such as restaurants, households, retailers, and event organizers, with organizations and individuals facing food insecurity."
            android:textColor="#FFFFFF"
            android:fontFamily="@font/indie_flower_font_family"
            android:textSize="16sp"
            android:textAlignment="center"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Donors can post surplus food for donation, and verified receivers can browse and accept available donations. Once a donation is accepted, donors and receivers can chat within the app to coordinate pickup."
            android:textColor="#FFFFFF"
            android:fontFamily="@font/indie_flower_font_family"
            android:textSize="16sp"
            android:textAlignment="center"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Our goal is to minimize food wastage and alleviate food insecurity by bridging the gap between food abundance and hunger, fostering a more sustainable and equitable food distribution system."
            android:textColor="#FFFFFF"
            android:fontFamily="@font/indie_flower_font_family"
            android:textSize="16sp"
            android:textAlignment="center"/>

    </LinearLayout>

</ScrollView>
